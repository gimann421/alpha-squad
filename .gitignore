models/**
!models/.gitkeep
predictions/**
!predictions/.gitkeep
reports/**
!reports/.gitkeep
state/**
!state/.gitkeep
*.duckdb
*.duckdb.wal

# Secrets
.env
.env.*
!.env.example

# Frontend
web/node_modules/
web/dist/
web/.vite/

# OS
.DS_Store
