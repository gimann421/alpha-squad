# Copy to .env and fill in locally. Never commit real values.
# NEVER put a real value directly in THIS file (.env.example) -- it is intentionally
# tracked by git (see .gitignore's `!.env.example`), so a real value here gets committed
# and, in a public repo, published. Real values belong in .env (gitignored) or this
# deployment environment's own env-var config, never in a tracked file. (This repo had a
# real key leak this way once already -- see docs/DECISIONS.md D35. `make check-secrets`/
# `make lint` now fails the build if this file ever gets a non-empty secret-shaped value
# again, D41.)
#
# As of docs/DECISIONS.md D36/D37, Sleeper/FantasyPros/CFBD are all confirmed reachable and
# live-tested with a valid key in this environment -- only KeepTradeCut and ESPN remain
# blocked by egress policy (see docs/DATA_SOURCES.md for current per-source status; re-verify
# with `alpha-squad sources status` before assuming any of this is still current).

# Sleeper — public API, no key required.
SLEEPER_BASE_URL=https://api.sleeper.app/v1

# FantasyPros — requires a paid API key.
FANTASYPROS_API_KEY=

# CollegeFootballData — requires a free API key.
CFBD_API_KEY=

# Optional: override the DuckDB path / data root
ALPHA_SQUAD_DATA_DIR=./data
ALPHA_SQUAD_DB_PATH=./data/alpha_squad.duckdb

# Claude strategic decision layer (Stage 1, docs/DECISIONS.md D74) — optional. Absent means
# the "Get Claude's Strategic Review" panel reports unavailable; Alpha's own recommendation
# is completely unaffected either way.
#
# In a Claude Code on the Web cloud environment, set ALPHA_SQUAD_ANTHROPIC_API_KEY instead of
# ANTHROPIC_API_KEY (D77): Claude Code on the Web reserves ANTHROPIC_API_KEY/ANTHROPIC_AUTH_TOKEN
# for its own subscription login and never exposes them to a cloud session's process
# environment, so a value set under that name there never reaches this app. Outside Claude Code
# (local dev, other hosting), plain ANTHROPIC_API_KEY still works as a fallback.
ALPHA_SQUAD_ANTHROPIC_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_SECONDS=20
