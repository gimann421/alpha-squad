# Copy to .env and fill in locally. Never commit real values.
# NEVER put a real value directly in THIS file (.env.example) -- it is intentionally
# tracked by git (see .gitignore's `!.env.example`), so a real value here gets committed
# and, in a public repo, published. Real values belong in .env (gitignored) or this
# deployment environment's own env-var config, never in a tracked file. (This repo had a
# real key leak this way once already -- see docs/DECISIONS.md D33/D34.)
# Sources currently BLOCKED by environment egress policy (see docs/DATA_SOURCES.md)
# are listed anyway so the adapters activate unchanged if access opens up.

# Sleeper — public API, no key required, but egress to api.sleeper.app is
# currently blocked in this environment (policy, not auth).
SLEEPER_BASE_URL=https://api.sleeper.app/v1

# FantasyPros — requires a paid API key. Not authorized/available in this
# environment; adapter is implemented and reports BLOCKED_BY_POLICY/NO_CREDENTIALS.
FANTASYPROS_API_KEY=

# CollegeFootballData — requires a free API key. api.collegefootballdata.com
# is currently blocked by environment egress policy regardless of key.
CFBD_API_KEY=

# Optional: override the DuckDB path / data root
ALPHA_SQUAD_DATA_DIR=./data
ALPHA_SQUAD_DB_PATH=./data/alpha_squad.duckdb
